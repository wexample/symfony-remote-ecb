{
  "name": "wexample/symfony-remote-ecb",
  "description": "Exchange rates from the European Central Bank reference rates, as symfony-money's provider, declared as a symfony-remote",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteEcb\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteEcb\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-remote": ">=2.0.0",
    "symfony/http-client": ">=7.0",
    "wexample/symfony-money": ">=6.0.0",
    "symfony/cache-contracts": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}